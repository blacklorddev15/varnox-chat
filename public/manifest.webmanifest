{
  "name": "Varnox",
  "short_name": "Varnox",
  "description": "Fast, private messaging with one-to-one chats, groups, photos and read receipts.",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0805",
  "theme_color": "#1a1509",
