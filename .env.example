# Copy to .env.local and fill in. Values here are placeholders.

# Postgres connection string. On Neon, use the *pooled* endpoint (the hostname containing
# "-pooler"), which is what a serverless deployment wants. Neon's string can include
# channel_binding=require — lib/pg.ts strips that parameter before opening the pool, so the
# string can be pasted in verbatim.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# HMAC key for signing session cookies. Any long random string. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Only needed if your Postgres presents a self-signed certificate, which Neon does not.
# DATABASE_SSL_NO_VERIFY=1

# ── SMS for phone login ────────────────────────────────────────────────
#
# Varnox generates, hashes and checks the login code itself; these settings only deliver
# it. Nothing works until one of SMS_PROVIDER or SMS_DEV_MODE is set, and the server
# refuses to claim it sent an SMS when it did not.

# Local work: print the code to the server log instead of sending (and paying for) an SMS.
# SMS_DEV_MODE=1

# Which gateway delivers the code: twilio | vonage | messagebird | generic | console
SMS_PROVIDER=twilio

# Optional second secret used only to hash codes at rest. Falls back to SESSION_SECRET.
# SMS_CODE_PEPPER=

# Twilio (Messages API). Prefer TWILIO_MESSAGING_SERVICE_SID when you have a messaging
# service — that is what handles sender pools, compliance and delivery features.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Varnox

# MessageBird
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=Varnox

# Any gateway that takes a JSON POST. {to} and {text} are substituted into the body, so a
# provider wanting {"recipient":"…","message":"…"} needs configuration rather than code.
GENERIC_SMS_URL=
GENERIC_SMS_TOKEN=
# GENERIC_SMS_BODY={"to":"{to}","text":"{text}"}

# ── schema reconciliation ──────────────────────────────────────────────
#
# On the first request a process serves, the app brings the database up to the shape the
# code expects: the idempotent statements from db/schema.sql, all of them "if not exists".
# It exists so a deploy cannot land ahead of its migration and produce a scatter of
# unrelated-looking 500s. GET /api/health reports what it found and fixed.
#
# Set AUTO_MIGRATE=0 to switch it off and manage migrations by hand.
# AUTO_MIGRATE=0

# ── calls (voice and video) ────────────────────────────────────────────
#
# A 1:1 call negotiates directly between the two browsers, so it needs ICE servers: STUN to
# discover each side's public address, and a TURN relay for the networks where a direct route
# cannot be found (symmetric NAT, some mobile carriers). STUN alone is enough to try; TURN is
# what makes it reliable.
#
# Comma separated when there is more than one. STUN falls back to Google's public server.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Who may read the dev SMS inbox (GET /api/sms/outbox). Comma-separated usernames.
# Only ever consulted when SMS_DEV_MODE is on. Empty means nobody.
# This screen shows live login codes, so treat membership as equivalent to full database access.
SMS_INBOX_USERNAMES=
