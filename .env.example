# Copy to .env.local and fill in. Values here are placeholders.

# Postgres connection string. On Neon, use the *pooled* endpoint (the hostname containing
# "-pooler"), which is what a serverless deployment wants. Neon's string can include
# channel_binding=require — lib/pg.ts strips that parameter before opening the pool, so the
# string can be pasted in verbatim.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# HMAC key for signing session cookies. Any long random string. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Only needed if your Postgres presents a self-signed certificate, which Neon does not.
# DATABASE_SSL_NO_VERIFY=1
